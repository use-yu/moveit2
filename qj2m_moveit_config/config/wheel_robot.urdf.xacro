<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import wheel_robot urdf file -->
    <xacro:include filename="$(find moveit_resources_qj2m_description)/urdf/arms_2w.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="wheel_robot.ros2_control.xacro" />


    <xacro:wheel_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
