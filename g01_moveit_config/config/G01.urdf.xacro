<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="G01">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import G01 urdf file -->
    <xacro:include filename="$(find moveit_resources_g01_description)/urdf/G01-URDF888.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="G01.ros2_control.xacro" />


    <xacro:G01_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
